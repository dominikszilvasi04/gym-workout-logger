# Application runtime profile
APPLICATION_ENV=production

# REQUIRED in production
APPLICATION_SECRET_KEY=replace-with-a-long-random-secret

# Logging
APPLICATION_LOG_LEVEL=INFO

# Session/cookie security
APPLICATION_SESSION_COOKIE_SECURE=true
APPLICATION_CSRF_PROTECTION_ENABLED=true

# Database
DATABASE_CONNECTION_URI=mongodb://mongo:27017/
DATABASE_NAME=gym_workout_logger_database

# Exercise request email notifications
APPLICATION_EXERCISE_REQUEST_RECIPIENT_EMAIL=owner@example.com
APPLICATION_SMTP_HOST=smtp.gmail.com
APPLICATION_SMTP_PORT=587
APPLICATION_SMTP_USERNAME=owner@example.com
APPLICATION_SMTP_PASSWORD=replace-with-app-password
APPLICATION_SMTP_SENDER_EMAIL=owner@example.com
APPLICATION_SMTP_USE_TLS=true
