# Application runtime profile
APPLICATION_ENV=production

# REQUIRED in production
APPLICATION_SECRET_KEY=replace-with-a-long-random-secret

# Logging
APPLICATION_LOG_LEVEL=INFO

# Session/cookie security
APPLICATION_SESSION_COOKIE_SECURE=true
APPLICATION_CSRF_PROTECTION_ENABLED=true

# Database
DATABASE_CONNECTION_URI=mongodb://mongo:27017/
DATABASE_NAME=gym_workout_logger_database
